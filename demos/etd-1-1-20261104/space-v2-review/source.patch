+/* Stage 1 only. Every selector is scoped to the opt-in spatial root, never the shell. */
+.space-v2-stage1{--space-v2-red:#b63b34;--space-v2-ink:#38454e}
+.space-v2-stage1 .space-map-panel{border-color:#d8dcdf}
+.space-v2-stage1 .space-map-heading .space-kicker{color:#5b646b;letter-spacing:1.3px}
+.space-v2-stage1 .space-map-heading h2{color:var(--space-v2-ink)}
+.space-v2-stage1 .space-live-label{color:#5c6971}
+.space-v2-stage1 .space-map-viewport{background:#f4f3f0}
+.space-v2-stage1 .space-v2-view-tag{position:absolute;z-index:3;top:12px;right:12px;display:flex;align-items:center;gap:14px;border:1px solid #d9dedd;border-radius:7px;padding:7px 10px;background:rgba(255,255,255,.94);box-shadow:0 2px 8px #26394d08;color:#354650;font-size:12px;line-height:1.4}
+.space-v2-stage1 .space-v2-view-tag>span{font-weight:650;white-space:nowrap}
+.space-v2-stage1 .space-v2-view-tag b{margin-left:7px;font-size:12px;font-weight:500;color:#5a676d}
+.space-v2-stage1 .space-v2-view-tag a{font-size:12px;color:#23518b;text-decoration:none;white-space:nowrap}
+.space-v2-stage1 .space-v2-view-tag a:hover{text-decoration:underline}
+.space-v2-stage1 .space-v2-view-tag a:focus-visible{outline:2px solid #23518b;outline-offset:3px;border-radius:2px}
+.space-v2-stage1 .space-v2-scene-key{position:absolute;z-index:2;bottom:12px;left:14px;display:flex;align-items:center;gap:7px;background:rgba(255,255,255,.88);padding:5px 8px;border-radius:4px;color:#4c5a63;font-size:12px;line-height:1.4;pointer-events:none}
+.space-v2-stage1 .space-v2-scene-key i{width:7px;height:7px;border-radius:2px;background:var(--space-v2-red)}
+.space-v2-stage1 .space-v2-scene-key span:last-child{padding-left:7px;border-left:1px solid #d4dadd;color:#59676e}
+.space-v2-stage1 .space-region-selected{fill:#c9473e;fill-opacity:.22;stroke:var(--space-v2-red)}
+.space-v2-stage1 .space-mode-3d .space-region-facts{border-color:#dfd9d7}
+@media(max-width:600px){
+  .space-v2-stage1 .space-v2-view-tag{top:9px;right:8px;gap:9px;padding:6px 8px}
+  .space-v2-stage1 .space-v2-view-tag b{display:none}
+  .space-v2-stage1 .space-v2-scene-key{bottom:9px;left:8px;padding:4px 6px}
+}
