# CPU is the default. Set cuda only after installing a compatible PyTorch build.
VISION_DEVICE=cpu
VISION_WEIGHTS=models/yolo11n-pose.pt
VISION_SAMPLE_FPS=2
CPU_THREADS=2
# sherpa | none | faster-whisper | openai | qwen. Missing models return a clear error.
ASR_PROVIDER=sherpa
SENSEVOICE_MODEL_DIR=models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17
ASR_MODEL_PATH=models/faster-whisper-tiny
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1
ASR_API_KEY=
ASR_LANGUAGE=zh
# Seeed Qwen3 compatible server, with POST /asr?language=zh (no GPU required here).
QWEN_ASR_URL=http://127.0.0.1:8001
# Optional Silero ONNX VAD. Without it audio energy intervals are explicitly approximate.
VAD_MODEL_PATH=
# rules | llm. No automatic fallback from a failed LLM call to a successful report.
ANALYSIS_PROVIDER=rules
# deepseek | ollama | openai | anthropic | custom. Mock is an explicit UI/API test mode,
# allowed only for a SIMULATED Session; never an automatic fallback/provider env.
# Official cloud default; the original Ollama adapter remains available.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_OUTPUT_TOKENS=16000
DEEPSEEK_API_KEY=
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# Explicit cloud opt-in; real research also requires project authorization.
HUBONE_DEEPSEEK_CLOUD_ENABLED=0
# Local fallback: LLM_PROVIDER=ollama, LLM_BASE_URL=http://127.0.0.1:11434/v1, LLM_MODEL=<installed model>.
# DeepSeek uses JSON mode or function tools; original report Schema is validated locally.
# OpenAI: https://api.openai.com/v1 + your model + LLM_API_KEY (or OPENAI_API_KEY)
# Anthropic: https://api.anthropic.com/v1 + your model + LLM_API_KEY (or ANTHROPIC_API_KEY)
# Custom: OpenAI-compatible base URL (including /v1 or provider prefix) + model + LLM_API_KEY
# Other OpenAI-compatible providers use strict JSON Schema; Anthropic uses forced tool output.
# Optional absolute path for database, uploads and reports (default ./runtime)
HUBONE_DATA_DIR=
