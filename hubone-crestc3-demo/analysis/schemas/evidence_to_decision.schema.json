{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^[A-Za-z0-9_-]{1,80}$",
          "title": "Claim Id",
          "type": "string"
        },
        "statement": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "classification": {
          "enum": [
            "FACT",
            "INFERENCE",
            "INSUFFICIENT_EVIDENCE"
          ],
          "title": "Classification",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Ids",
          "type": "array"
        },
        "reasoning": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reasoning",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "statement",
        "classification",
        "evidence_ids",
        "reasoning"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "recommendation": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Recommendation",
          "type": "string"
        },
        "classification": {
          "enum": [
            "INFERENCE",
            "INSUFFICIENT_EVIDENCE"
          ],
          "title": "Classification",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Ids",
          "type": "array"
        },
        "data_gaps": {
          "items": {
            "type": "string"
          },
          "maxItems": 15,
          "minItems": 1,
          "title": "Data Gaps",
          "type": "array"
        }
      },
      "required": [
        "recommendation",
        "classification",
        "evidence_ids",
        "data_gaps"
      ],
      "title": "Decision",
      "type": "object"
    },
    "Diagnosis": {
      "additionalProperties": false,
      "properties": {
        "diagnosis_id": {
          "pattern": "^[A-Za-z0-9_-]{1,80}$",
          "title": "Diagnosis Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "explanation": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "classification": {
          "enum": [
            "INFERENCE",
            "INSUFFICIENT_EVIDENCE"
          ],
          "title": "Classification",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "alternative_explanations": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Alternative Explanations",
          "type": "array"
        },
        "missing_evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Missing Evidence",
          "type": "array"
        }
      },
      "required": [
        "diagnosis_id",
        "title",
        "explanation",
        "classification",
        "evidence_ids",
        "alternative_explanations",
        "missing_evidence"
      ],
      "title": "Diagnosis",
      "type": "object"
    },
    "Experiment": {
      "additionalProperties": false,
      "properties": {
